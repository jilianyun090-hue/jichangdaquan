---
import type { CollectionEntry } from 'astro:content';
import {
  BUDGET_BANDS,
  USE_CASES,
  LINES,
  STREAMING,
  PAYMENTS,
  STATUS_STYLE,
  EVIDENCE_STYLE,
  recommendRank,
} from '../data/taxonomy';

interface Props {
  airports: CollectionEntry<'airports'>[];
}

const { airports } = Astro.props;

// 预先算好每个机场的可筛选数据，塞进 data-* 属性，交给前端 JS 过滤。
const rows = airports.map((a) => {
  const d = a.data;
  const priceLabel =
    d.price_monthly_min != null
      ? d.price_monthly_max != null && d.price_monthly_max !== d.price_monthly_min
        ? `¥${d.price_monthly_min}–${d.price_monthly_max}`
        : `¥${d.price_monthly_min}`
      : '待复测';
  return {
    id: a.id,
    name: d.name,
    aliases: d.aliases.join(' '),
    summary: d.summary,
    tier: d.tier ?? '',
    budget: d.budget_band ?? '',
    useCases: d.use_cases,
    lines: d.lines,
    streaming: d.streaming,
    payment: d.payment,
    status: d.status,
    evidence: d.evidence,
    rating: d.rating,
    priceMin: d.price_monthly_min ?? 99999, // 无价格的排到最后
    priceLabel,
    weight: d.weight,
    order: recommendRank(a.id),
    affiliate: d.affiliate_url,
    officialOnly: d.official_only,
    statusStyle: STATUS_STYLE[d.status],
    evidenceStyle: EVIDENCE_STYLE[d.evidence],
  };
});
---

<section class="rounded-2xl border border-gray-200 bg-white p-4 md:p-6">
  <!-- 搜索 + 排序 -->
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <input
      id="f-search"
      type="search"
      placeholder="搜索机场名称…"
      class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:border-blue-500 focus:outline-none md:max-w-xs"
    />
    <div class="flex items-center gap-2 text-sm">
      <label for="f-sort" class="text-gray-500">排序</label>
      <select id="f-sort" class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
        <option value="default">默认</option>
        <option value="price-asc">价格 低→高</option>
        <option value="price-desc">价格 高→低</option>
        <option value="rating-desc">评分 高→低</option>
        <option value="name">名称</option>
      </select>
    </div>
  </div>

  <!-- 筛选组 -->
  <div class="mt-4 grid gap-3 border-t border-gray-100 pt-4 text-sm">
    <div class="flex flex-wrap items-center gap-2">
      <span class="w-14 shrink-0 text-gray-500">预算</span>
      {BUDGET_BANDS.map((b) => (
        <button class="filter-btn" data-group="budget" data-value={b}>{b}</button>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="w-14 shrink-0 text-gray-500">用途</span>
      {USE_CASES.map((u) => (
        <button class="filter-btn" data-group="use" data-value={u}>{u}</button>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="w-14 shrink-0 text-gray-500">流媒体</span>
      {STREAMING.map((s) => (
        <button class="filter-btn" data-group="streaming" data-value={s}>{s}</button>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="w-14 shrink-0 text-gray-500">线路</span>
      {LINES.map((l) => (
        <button class="filter-btn" data-group="line" data-value={l}>{l}</button>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="w-14 shrink-0 text-gray-500">支付</span>
      {PAYMENTS.map((p) => (
        <button class="filter-btn" data-group="payment" data-value={p}>{p}</button>
      ))}
    </div>
    <div class="flex items-center justify-between">
      <label class="flex items-center gap-2 text-gray-600">
        <input id="f-hide-dead" type="checkbox" class="rounded" />
        隐藏已停运/跑路
      </label>
      <button id="f-reset" class="text-blue-600 hover:underline">重置筛选</button>
    </div>
  </div>

  <!-- 结果计数 -->
  <p class="mt-4 text-sm text-gray-500"><span id="f-count">{rows.length}</span> 个机场</p>

  <!-- 结果网格 -->
  <div id="f-grid" class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      rows.map((r) => (
        <article
          class="airport-row flex flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:shadow-md"
          data-name={`${r.name} ${r.aliases}`.toLowerCase()}
          data-budget={r.budget}
          data-use={r.useCases.join('|')}
          data-streaming={r.streaming.join('|')}
          data-line={r.lines.join('|')}
          data-payment={r.payment.join('|')}
          data-status={r.status}
          data-price={r.priceMin}
          data-rating={r.rating ?? -1}
          data-weight={r.weight}
          data-order={r.order}
        >
          <div class="flex items-start justify-between gap-2">
            <a href={`/airports/${r.id}/`} class="font-semibold text-gray-900 hover:text-blue-600">
              {r.name}
            </a>
            <span class={`shrink-0 rounded-full px-2 py-0.5 text-xs ${r.statusStyle.cls}`}>
              {r.statusStyle.label}
            </span>
          </div>
          <div class="mt-2 flex flex-wrap gap-1.5 text-xs">
            {r.tier && <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-600">{r.tier}</span>}
            {r.budget && <span class="rounded bg-blue-50 px-2 py-0.5 text-blue-700">{r.budget}</span>}
            <span class={`rounded px-2 py-0.5 ${r.evidenceStyle.cls}`}>{r.evidence}</span>
          </div>
          <p class="mt-2 line-clamp-2 text-sm text-gray-500">{r.summary}</p>
          <div class="mt-auto flex items-center justify-between pt-3">
            <span class="text-sm font-medium text-gray-700">
              {r.priceLabel === '待复测' ? '价格待复测' : `${r.priceLabel}/月`}
            </span>
            <div class="flex gap-2">
              <a
                href={`/airports/${r.id}/`}
                class="rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50"
              >
                详情
              </a>
              {
                r.affiliate ? (
                  <a
                    href={r.affiliate}
                    target="_blank"
                    rel="nofollow noopener sponsored"
                    class="rounded-md bg-blue-600 px-3 py-1.5 text-sm text-white hover:bg-blue-700"
                  >
                    {r.officialOnly ? '官网注册' : '注册'}
                  </a>
                ) : (
                  <span class="rounded-md bg-gray-100 px-3 py-1.5 text-sm text-gray-400">链接待补充</span>
                )
              }
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <p id="f-empty" class="hidden py-8 text-center text-gray-400">
    没有符合条件的机场。部分机场数据仍为「待复测」、不带价格/分类标签，不会出现在按价格或分类的筛选结果里，试试放宽或重置筛选。
  </p>
</section>

<style>
  .filter-btn {
    border: 1px solid rgb(209 213 219);
    border-radius: 9999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    color: rgb(75 85 99);
    transition: all 0.15s;
  }
  .filter-btn:hover {
    background: rgb(243 244 246);
  }
  .filter-btn[aria-pressed='true'] {
    background: rgb(37 99 235);
    border-color: rgb(37 99 235);
    color: white;
  }
</style>

<script>
  // 纯前端筛选：无框架、无请求，全部在已渲染的 DOM 上做显隐与排序。
  const grid = document.getElementById('f-grid')!;
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.airport-row'));
  const search = document.getElementById('f-search') as HTMLInputElement;
  const sort = document.getElementById('f-sort') as HTMLSelectElement;
  const hideDead = document.getElementById('f-hide-dead') as HTMLInputElement;
  const reset = document.getElementById('f-reset')!;
  const count = document.getElementById('f-count')!;
  const empty = document.getElementById('f-empty')!;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));

  // 当前激活的筛选条件：按组收集（组内多选 = 或，跨组 = 且）
  const active: Record<string, Set<string>> = {
    budget: new Set(),
    use: new Set(),
    streaming: new Set(),
    line: new Set(),
    payment: new Set(),
  };

  function matchGroup(row: HTMLElement, group: string, attr: string): boolean {
    const set = active[group];
    if (set.size === 0) return true;
    const vals = (row.dataset[attr] || '').split('|');
    for (const v of set) if (vals.includes(v)) return true;
    return false;
  }

  function apply() {
    const q = search.value.trim().toLowerCase();
    let visible = 0;

    rows.forEach((row) => {
      let show = true;
      if (q && !(row.dataset.name || '').includes(q)) show = false;
      if (show && !matchGroup(row, 'budget', 'budget')) show = false;
      if (show && !matchGroup(row, 'use', 'use')) show = false;
      if (show && !matchGroup(row, 'streaming', 'streaming')) show = false;
      if (show && !matchGroup(row, 'line', 'line')) show = false;
      if (show && !matchGroup(row, 'payment', 'payment')) show = false;
      if (show && hideDead.checked) {
        const s = row.dataset.status;
        if (s === '停运' || s === '跑路') show = false;
      }
      row.dataset.hidden = show ? 'false' : 'true';
      if (show) visible++;
    });

    // 排序
    const mode = sort.value;
    const sorted = [...rows].sort((a, b) => {
      switch (mode) {
        case 'price-asc':
          return Number(a.dataset.price) - Number(b.dataset.price);
        case 'price-desc':
          return Number(b.dataset.price) - Number(a.dataset.price);
        case 'rating-desc':
          return Number(b.dataset.rating) - Number(a.dataset.rating);
        case 'name':
          return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'zh');
        default:
          return Number(a.dataset.order) - Number(b.dataset.order) ||
            (a.dataset.name || '').localeCompare(b.dataset.name || '', 'zh');
      }
    });
    sorted.forEach((r) => grid.appendChild(r));

    count.textContent = String(visible);
    empty.classList.toggle('hidden', visible !== 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.dataset.group!;
      const value = btn.dataset.value!;
      const pressed = btn.getAttribute('aria-pressed') === 'true';
      btn.setAttribute('aria-pressed', String(!pressed));
      if (pressed) active[group].delete(value);
      else active[group].add(value);
      apply();
    });
  });

  search.addEventListener('input', apply);
  sort.addEventListener('change', apply);
  hideDead.addEventListener('change', apply);
  reset.addEventListener('click', () => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
    Object.values(active).forEach((s) => s.clear());
    search.value = '';
    sort.value = 'default';
    hideDead.checked = false;
    apply();
  });

  apply();
</script>
