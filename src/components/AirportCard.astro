---
import { STATUS_STYLE, EVIDENCE_STYLE } from '../data/taxonomy';
import type { CollectionEntry } from 'astro:content';

interface Props {
  airport: CollectionEntry<'airports'>;
}

const { airport } = Astro.props;
const d = airport.data;
const statusStyle = STATUS_STYLE[d.status];
const evidenceStyle = EVIDENCE_STYLE[d.evidence];

const priceLabel =
  d.price_monthly_min != null
    ? d.price_monthly_max != null && d.price_monthly_max !== d.price_monthly_min
      ? `¥${d.price_monthly_min}–${d.price_monthly_max}/月`
      : `¥${d.price_monthly_min}/月起`
    : '价格待复测';
---

<article class="flex flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:shadow-md">
  <div class="flex items-start justify-between gap-2">
    <a href={`/airports/${airport.id}/`} class="font-semibold text-gray-900 hover:text-blue-600">
      {d.name}
    </a>
    <span class={`shrink-0 rounded-full px-2 py-0.5 text-xs ${statusStyle.cls}`}>
      {statusStyle.label}
    </span>
  </div>

  <div class="mt-2 flex flex-wrap gap-1.5 text-xs">
    {d.tier && <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-600">{d.tier}</span>}
    {d.budget_band && <span class="rounded bg-blue-50 px-2 py-0.5 text-blue-700">{d.budget_band}</span>}
    <span class={`rounded px-2 py-0.5 ${evidenceStyle.cls}`}>{d.evidence}</span>
  </div>

  {
    d.use_cases.length > 0 && (
      <div class="mt-2 flex flex-wrap gap-1.5 text-xs text-gray-500">
        {d.use_cases.map((u) => (
          <span>#{u}</span>
        ))}
      </div>
    )
  }

  <p class="mt-2 line-clamp-2 text-sm text-gray-500">{d.summary}</p>

  <div class="mt-auto flex items-center justify-between pt-3">
    <span class="text-sm font-medium text-gray-700">{priceLabel}</span>
    <div class="flex gap-2">
      <a
        href={`/airports/${airport.id}/`}
        class="rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 hover:bg-gray-50"
      >
        详情
      </a>
      <a
        href={d.affiliate_url}
        target="_blank"
        rel="nofollow noopener sponsored"
        class="rounded-md bg-blue-600 px-3 py-1.5 text-sm text-white hover:bg-blue-700"
      >
        注册直达
      </a>
    </div>
  </div>
</article>
