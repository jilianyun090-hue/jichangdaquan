---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FilterTable from '../components/FilterTable.astro';
import { BEST_PAGES, GUIDE_CATEGORIES } from '../data/taxonomy';

const airports = await getCollection('airports');
// 按权重、再按名称排
airports.sort((a, b) => b.data.weight - a.data.weight || a.data.name.localeCompare(b.data.name, 'zh'));

const total = airports.length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '机场大全 jichangdaquan.org',
  url: 'https://jichangdaquan.org',
  description: `收录 ${total} 家主流机场，按价格、用途、线路、流媒体解锁多维筛选。`,
};
---

<Base
  title="机场大全 jichangdaquan.org"
  description={`机场大全收录 ${total} 家主流机场（VPN/代理订阅服务），支持按价格、用途（ChatGPT/流媒体/游戏）、线路、流媒体解锁、支付方式多维筛选，帮你快速选到合适的机场。`}
  jsonLd={jsonLd}
  path="/"
>
  <!-- Hero -->
  <section class="rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-600 px-6 py-12 text-white md:px-10 md:py-16">
    <h1 class="text-3xl font-bold md:text-4xl">机场大全</h1>
    <p class="mt-3 max-w-2xl text-blue-100">
      收录市面主流机场（VPN/代理订阅服务），按价格、需求、用途一站筛选。
      所有数据标注证据等级，<strong class="text-white">未核实即标「待复测」，绝不编造</strong>，以官网为准。
    </p>
    <div class="mt-6 flex flex-wrap gap-3 text-sm">
      {
        BEST_PAGES.map((b) => (
          <a
            href={`/best/${b.slug}/`}
            class="rounded-full bg-white/15 px-4 py-2 font-medium backdrop-blur transition hover:bg-white/25"
          >
            {b.title}
          </a>
        ))
      }
    </div>
  </section>

  <!-- 筛选对比 -->
  <h2 class="mt-10 mb-4 text-xl font-bold">筛选 · 对比机场（共 {total} 家）</h2>
  <FilterTable airports={airports} />

  <!-- 教程指南入口 -->
  <h2 class="mt-12 mb-4 text-xl font-bold">教程指南</h2>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      GUIDE_CATEGORIES.map((c) => (
        <a
          href={`/guide/${c.slug}/`}
          class="flex items-center gap-3 rounded-xl border border-gray-200 bg-white p-4 transition hover:shadow-md"
        >
          <span class="text-2xl">{c.icon}</span>
          <div>
            <div class="font-semibold text-gray-900">{c.name}</div>
            <div class="line-clamp-1 text-sm text-gray-500">{c.desc}</div>
          </div>
        </a>
      ))
    }
  </div>

  <p class="mt-10 text-center text-sm text-gray-400">
    数据持续补充核实中。发现信息有误？欢迎到 <a href="/blog/" class="text-blue-600 hover:underline">博客</a> 反馈。
  </p>
</Base>
