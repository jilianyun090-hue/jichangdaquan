---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
};
---

<Base title={d.title} description={d.description} jsonLd={jsonLd} path={`/blog/${post.id}/`}>
  <nav class="mb-4 text-sm text-gray-400">
    <a href="/" class="hover:text-gray-600">首页</a> ›
    <a href="/blog/" class="hover:text-gray-600">博客</a> ›
    <span class="text-gray-600">{d.title}</span>
  </nav>
  <article class="rounded-2xl border border-gray-200 bg-white p-6 md:p-8">
    <div class="flex items-center gap-2 text-xs text-gray-400">
      <span class="rounded bg-gray-100 px-2 py-0.5 text-gray-600">{d.category}</span>
      <time>{d.pubDate.toISOString().slice(0, 10)}</time>
    </div>
    <h1 class="mt-2 text-2xl font-bold">{d.title}</h1>
    <p class="mt-2 text-gray-500">{d.description}</p>
    <div class="prose prose-sm mt-6 max-w-none border-t border-gray-100 pt-6">
      <Content />
    </div>
  </article>
</Base>
