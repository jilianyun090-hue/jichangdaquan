---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { GUIDE_CATEGORIES, guideCategoryName } from '../../../data/taxonomy';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map((g) => {
    const slug = g.id.split('/').pop();
    return {
      params: { category: g.data.category, slug },
      props: { guide: g },
    };
  });
}

const { guide } = Astro.props;
const d = guide.data;
const { Content, headings } = await render(guide);
const cat = GUIDE_CATEGORIES.find((c) => c.slug === d.category)!;
const slug = guide.id.split('/').pop();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description: d.description,
  articleSection: guideCategoryName(d.category),
  ...(d.updatedDate ? { dateModified: d.updatedDate.toISOString() } : {}),
};
---

<Base title={d.title} description={d.description} jsonLd={jsonLd} path={`/guide/${d.category}/${slug}/`}>
  <nav class="mb-4 text-sm text-gray-400">
    <a href="/" class="hover:text-gray-600">首页</a> ›
    <a href="/guide/" class="hover:text-gray-600">教程指南</a> ›
    <a href={`/guide/${cat.slug}/`} class="hover:text-gray-600">{cat.name}</a> ›
    <span class="text-gray-600">{d.title}</span>
  </nav>

  <article class="rounded-2xl border border-gray-200 bg-white p-6 md:p-8">
    <h1 class="text-2xl font-bold">{d.title}</h1>
    <p class="mt-2 text-gray-500">{d.description}</p>
    {
      d.updatedDate && (
        <p class="mt-1 text-xs text-gray-400">更新于 {d.updatedDate.toISOString().slice(0, 10)}</p>
      )
    }

    {
      headings.filter((h) => h.depth === 2).length > 1 && (
        <nav class="mt-5 rounded-lg bg-gray-50 p-4 text-sm">
          <p class="mb-2 font-medium text-gray-700">本页目录</p>
          <ul class="space-y-1">
            {headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="text-blue-600 hover:underline">
                    {h.text}
                  </a>
                </li>
              ))}
          </ul>
        </nav>
      )
    }

    <div class="prose prose-sm mt-6 max-w-none border-t border-gray-100 pt-6">
      <Content />
    </div>

    <div class="mt-8 rounded-lg bg-blue-50 p-4 text-sm text-blue-800">
      还没有机场？去 <a href="/airports/" class="font-medium underline">机场列表</a> 按价格和需求筛选，
      或看 <a href="/guide/getting-started/" class="font-medium underline">入门教程</a>。
    </div>
  </article>
</Base>
