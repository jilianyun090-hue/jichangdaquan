---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { GUIDE_CATEGORIES } from '../../../data/taxonomy';

export async function getStaticPaths() {
  return GUIDE_CATEGORIES.map((c) => ({ params: { category: c.slug }, props: { cat: c } }));
}

const { cat } = Astro.props;
const items = (await getCollection('guides', ({ data }) => !data.draft && data.category === cat.slug)).sort(
  (a, b) => a.data.order - b.data.order,
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${cat.name} · 教程指南`,
  url: `https://jichangdaquan.org/guide/${cat.slug}/`,
};
---

<Base title={`${cat.name} · 教程指南`} description={cat.desc} jsonLd={jsonLd} path={`/guide/${cat.slug}/`}>
  <nav class="mb-4 text-sm text-gray-400">
    <a href="/" class="hover:text-gray-600">首页</a> ›
    <a href="/guide/" class="hover:text-gray-600">教程指南</a> ›
    <span class="text-gray-600">{cat.name}</span>
  </nav>

  <div class="flex items-center gap-3">
    <span class="text-3xl">{cat.icon}</span>
    <div>
      <h1 class="text-2xl font-bold">{cat.name}</h1>
      <p class="text-gray-500">{cat.desc}</p>
    </div>
  </div>

  <div class="mt-6 space-y-3">
    {
      items.map((g) => (
        <a
          href={`/guide/${cat.slug}/${g.id.split('/').pop()}/`}
          class="block rounded-xl border border-gray-200 bg-white p-5 transition hover:shadow-md"
        >
          <h2 class="font-semibold text-gray-900">{g.data.title}</h2>
          <p class="mt-1 text-sm text-gray-500">{g.data.description}</p>
          {g.data.tags.length > 0 && (
            <div class="mt-2 flex flex-wrap gap-1.5 text-xs text-gray-400">
              {g.data.tags.map((t) => (
                <span>#{t}</span>
              ))}
            </div>
          )}
        </a>
      ))
    }
    {items.length === 0 && (
      <p class="rounded-xl border border-dashed border-gray-300 bg-white p-6 text-center text-gray-400">
        本板块文章正在编写中。
      </p>
    )}
  </div>
</Base>
