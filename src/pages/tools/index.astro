  },
  {
    category: '节点测试工具',
    id: 'testing',
    items: [
      {
        name: 'Cloudflare Speed Test',
        desc: '测试节点到 Cloudflare 的连接速度',
        url: 'https://speed.cloudflare.com/',
        icon: '',
      },
      {
        name: 'Ping.pe',
        desc: '全球多地 Ping 测试',
        url: 'https://ping.pe/',
        icon: '',
      },
      {
        name: 'LookingGlass',
        desc: '服务器网络状态查询',
        url: 'https://lg.he.net/',
        icon: '',
      },
    ],
  },
  {
    category: '学习资源',
    id: 'learning',
    items: [
      {
        name: 'Clash 文档',
        desc: 'Clash 官方使用文档',
        url: 'https://clash.wiki/',
        icon: '',
      },
      {
        name: 'V2Ray 白话文教程',
        desc: 'V2Ray 新手友好教程',
        url: 'https://guide.v2fly.org/',
        icon: '',
      },
      {
        name: 'Shadowsocks 文档',
        desc: 'Shadowsocks 官方文档',
        url: 'https://shadowsocks.org/',
        icon: '',
      },
    ],
  },
];

const title = '机场工具导航';
const description = '机场节点相关工具大全：网络测速、DNS/WebRTC 检测、流媒体解锁测试、客户端下载、订阅转换、分流规则等实用工具导航。';
---

<Base title={title} description={description} path="/tools/">
  <!-- Hero -->
  <section class="border-b border-gray-200 pb-8">
    <p class="text-sm font-semibold text-emerald-700">TOOLS & RESOURCES</p>
    <h1 class="mt-2 text-3xl font-bold text-gray-950">机场工具导航</h1>
    <p class="mt-3 max-w-3xl leading-7 text-gray-600">
      整理常用的网络检测、流媒体解锁测试、客户端下载、订阅转换等实用工具。
      点击工具卡片即可跳转到对应页面，部分工具需要科学上网环境访问。
    </p>
  </section>

  <!-- Tools Grid -->
  {
    tools.map((category) => (
      <section class="mt-10" id={category.id}>
        <h2 class="mb-4 text-xl font-bold text-gray-900">{category.category}</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {category.items.map((tool) => (
            <a
              href={tool.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-3 rounded-xl border border-gray-200 bg-white p-4 transition hover:border-emerald-600 hover:shadow-md"
            >
              <span class="text-3xl">{tool.icon}</span>
              <div class="min-w-0 flex-1">
                <div class="font-semibold text-gray-900 group-hover:text-emerald-700">
                  {tool.name}
                </div>
                <p class="mt-1 text-sm text-gray-500">{tool.desc}</p>
              </div>
              <svg class="h-4 w-4 shrink-0 text-gray-400 transition group-hover:text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <!-- Quick Navigation -->
  <section class="mt-12 rounded-2xl bg-emerald-50 p-6">
    <h2 class="mb-4 text-lg font-bold text-gray-900">快速导航</h2>
    <div class="flex flex-wrap gap-2">
      {
        tools.map((category) => (
          <a
            href={`#${category.id}`}
            class="rounded-md border border-emerald-200 bg-white px-3 py-1.5 text-sm text-gray-700 hover:border-emerald-600 hover:text-emerald-700"
          >
            {category.category}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Usage Tips -->
  <section class="mt-12 rounded-2xl bg-white p-6">
    <h2 class="mb-4 text-lg font-bold text-gray-900">使用提示</h2>
    <div class="space-y-3 text-sm text-gray-600">
      <p>
        <strong class="text-gray-900">网络检测：</strong>
        使用测速工具前，建议先断开代理测试本地网络，再连接机场节点对比速度差异。
      </p>
      <p>
        <strong class="text-gray-900">隐私检测：</strong>
        DNS 和 WebRTC 泄漏会暴露真实 IP，使用机场前务必检测是否存在泄漏。
      </p>
      <p>
        <strong class="text-gray-900">流媒体解锁：</strong>
        不同机场的流媒体解锁能力差异很大，购买前可咨询客服或查看机场详情页的标注。
      </p>
      <p>
        <strong class="text-gray-900">客户端选择：</strong>
        新手推荐 Clash Verge Rev（桌面端）和 Clash Meta（Android），iOS 推荐 Shadowrocket 或 Surge。
      </p>
      <p>
        <strong class="text-gray-900">规则更新：</strong>
        分流规则建议定期更新，以获得最佳的访问体验和广告过滤效果。
      </p>
    </div>
  </section>

  <!-- Back to Home -->
  <div class="mt-12 text-center">
    <a href="/" class="text-sm text-emerald-700 hover:underline">← 返回首页</a>
    <span class="mx-2 text-gray-300">|</span>
    <a href="/airports/" class="text-sm text-emerald-700 hover:underline">查看机场列表</a>
    <span class="mx-2 text-gray-300">|</span>
    <a href="/blog/" class="text-sm text-emerald-700 hover:underline">阅读选购文章</a>
  </div>
</Base>
