---
import Base from '../../layouts/Base.astro';

const tools = [
  {
    category: '网络检测工具',
    id: 'network',
    items: [
      {
        name: 'Speedtest 测速',
        desc: '测试当前网络的下载、上传速度和延迟',
        url: 'https://www.speedtest.net/',
        icon: '',
      },
      {
        name: 'Fast.com 测速',
        desc: 'Netflix 提供的简洁测速工具',
        url: 'https://fast.com/',
        icon: '',
      },
      {
        name: 'IP 查询',
        desc: '查看当前 IP 地址和地理位置',
        url: 'https://ip.sb/',
        icon: '',
      },
      {
        name: 'DNS 泄漏检测',
        desc: '检查 DNS 请求是否泄漏真实位置',
        url: 'https://dnsleaktest.com/',
        icon: '',
      },
      {
        name: 'WebRTC 泄漏检测',
        desc: '检测 WebRTC 是否泄漏真实 IP',
        url: 'https://browserleaks.com/webrtc',
        icon: '',
      },
      {
        name: 'ipleak.net',
        desc: '综合检测 IP、DNS、WebRTC 泄漏',
        url: 'https://ipleak.net/',
        icon: '',
      },
    ],
  },
  {
    category: '流媒体解锁检测',
    id: 'streaming',
    items: [
      {
        name: 'Netflix 区域检测',
        desc: '检测当前 IP 可访问的 Netflix 区域',
        url: 'https://www.netflix.com/',
        icon: '',
      },
      {
        name: 'Disney+ 检测',
        desc: '测试 Disney+ 流媒体解锁情况',
        url: 'https://www.disneyplus.com/',
        icon: '',
      },
      {
        name: 'YouTube Premium 检测',
        desc: '检查 YouTube Premium 功能可用性',
        url: 'https://www.youtube.com/premium',
        icon: '',
      },
      {
        name: 'ChatGPT 访问检测',
        desc: '测试 ChatGPT 是否可正常访问',
        url: 'https://chat.openai.com/',
        icon: '',
      },
    ],
  },
  {
    category: '客户端下载',
    id: 'clients',
    items: [
      {
        name: 'Clash Verge Rev',
        desc: 'Windows/macOS/Linux 跨平台客户端（推荐）',
        url: 'https://github.com/clash-verge-rev/clash-verge-rev/releases',
        icon: '',
      },
      {
        name: 'Clash Meta for Android',
        desc: 'Android 平台 Clash 客户端',
        url: 'https://github.com/MetaCubeX/ClashMetaForAndroid/releases',
        icon: '',
      },
      {
        name: 'Shadowrocket',
        desc: 'iOS 平台付费客户端（App Store）',
        url: 'https://apps.apple.com/app/shadowrocket/id932747118',
        icon: '',
      },
      {
        name: 'V2rayN',
        desc: 'Windows 平台 V2ray 客户端',
        url: 'https://github.com/2dust/v2rayN/releases',
        icon: '',
      },
      {
        name: 'Surge',
        desc: 'macOS/iOS 专业级网络工具',
        url: 'https://nssurge.com/',
        icon: '',
      },
      {
        name: 'NekoBox',
        desc: 'Android 多协议客户端',
        url: 'https://github.com/MatsuriDayo/NekoBoxForAndroid/releases',
        icon: '',
      },
    ],
  },
  {
    category: '订阅转换工具',
    id: 'converter',
    items: [
      {
        name: 'Sub-Store',
        desc: '订阅管理与转换工具',
        url: 'https://sub-store.vercel.app/',
        icon: '',
      },
      {
        name: '订阅转换器',
        desc: '在线订阅链接格式转换',
