---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { STATUS_STYLE, recommendRank, sortByRecommendation } from '../../data/taxonomy';

const year = new Date().getFullYear();
const all = sortByRecommendation(await getCollection('airports'));

const sorted = all;

const priceLabel = (a: (typeof all)[number]) =>
  a.data.price_monthly_min != null ? `¥${a.data.price_monthly_min}` : '—';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${year} 机场品牌横向对比`,
  numberOfItems: sorted.length,
  itemListElement: sorted.slice(0, 20).map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.data.name,
    url: `https://jichangdaquan.org/airports/${a.id}/`,
  })),
};
---

<Base
  title={`机场横向对比 ${year} · 品牌对比表`}
  description={`${sorted.length} 家机场横向对比表：并排查看价格、流量、线路、解锁标签和状态，顺序采用站点编辑推荐序列。公开资料以机场官网为准。`}
  keywords={['机场对比', '机场横向对比', '机场品牌对比', '机场推荐', '机场排名']}
  jsonLd={jsonLd}
  path="/compare/"
>
  <div class="flex flex-wrap items-end justify-between gap-2">
    <h1 class="text-2xl font-bold">品牌横向对比</h1>
  <span class="text-sm text-gray-400">按编辑推荐顺序 · 共 {sorted.length} 家</span>
  </div>
  <p class="mt-2 max-w-3xl text-gray-500">
    把各家机场的价格、流量、线路、流媒体/AI 解锁、支付与运营状态并排放在一张表里，方便横向比较。
    榜单顺序按站点编辑推荐序列排列，不代表测速分数或独立实测结论。数据为公开信息整理，<strong>以官网为准</strong>。
  </p>

  <div class="mt-6 overflow-x-auto rounded-xl border border-gray-200 bg-white">
    <table class="w-full min-w-[820px] text-sm">
      <thead class="border-b border-gray-200 bg-gray-50 text-left text-gray-500">
        <tr>
          <th class="px-3 py-3">#</th>
          <th class="px-3 py-3">机场</th>
          <th class="px-3 py-3">月付起</th>
          <th class="px-3 py-3">流量</th>
          <th class="px-3 py-3">线路</th>
          <th class="px-3 py-3">解锁</th>
          <th class="px-3 py-3">状态</th>
          <th class="px-3 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {
          sorted.map((a, i) => {
            const d = a.data;
            const top = i < 2 && recommendRank(a.id) < 9999;
            return (
              <tr class={`border-b border-gray-100 last:border-0 ${top ? 'bg-amber-50/60' : ''}`}>
    <td class="px-3 py-3 font-medium text-gray-400">
                  {i === 0 ? '🥇' : i === 1 ? '🥈' : i + 1}
                </td>
                <td class="px-3 py-3">
                  <a href={`/airports/${a.id}/`} class="font-medium text-gray-900 hover:text-blue-600">
                    {d.name}
                  </a>
                </td>
                <td class="px-3 py-3 font-medium text-gray-700">{priceLabel(a)}</td>
                <td class="px-3 py-3 text-gray-500">{d.traffic_gb ? `${d.traffic_gb}G` : '—'}</td>
                <td class="px-3 py-3 text-gray-500">{d.lines.join('/') || '—'}</td>
                <td class="max-w-[200px] px-3 py-3 text-xs text-gray-500">
                  {d.streaming.length ? d.streaming.join('、') : '—'}
                </td>
                <td class="px-3 py-3">
                  <span class={`whitespace-nowrap rounded-full px-2 py-0.5 text-xs ${STATUS_STYLE[d.status].cls}`}>
                    {STATUS_STYLE[d.status].label}
                  </span>
                </td>
                <td class="px-3 py-3">
                  {d.affiliate_url ? (
                    <a
                      href={d.affiliate_url}
                      target="_blank"
                      rel="nofollow noopener sponsored"
                      class="whitespace-nowrap rounded-md bg-blue-600 px-3 py-1.5 text-xs text-white hover:bg-blue-700"
                    >
                      {d.official_only ? '官网注册' : '注册'}
                    </a>
                  ) : (
                    <span class="text-xs text-gray-400">—</span>
                  )}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <p class="mt-4 text-xs text-gray-400">
    「—」表示该项暂无公开数据（待复测）。运营状态单独标注，不改变编辑推荐顺序；已停运或跑路的服务请勿充值。
  </p>

  <section class="mt-10 rounded-2xl bg-white p-6 text-sm leading-relaxed text-gray-600">
    <h2 class="mb-3 text-lg font-bold text-gray-900">怎么看这张对比表</h2>
    <p>
    表格按编辑推荐序列排列，价格、线路和支持情况单独呈现，不构成测试评分。横向对比时重点看三列：
      <strong>价格</strong>（预算）、<strong>线路</strong>（IEPL/IPLC 专线晚高峰更稳）、
      <strong>解锁</strong>（看 Netflix、用 ChatGPT 的刚需）。想按单一维度排名见
      <a href="/ranking/" class="text-blue-600 hover:underline">机场排名</a>，
      想按需求筛选见<a href="/airports/" class="text-blue-600 hover:underline">机场列表</a>。
    </p>
  </section>
</Base>
